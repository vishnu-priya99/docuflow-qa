# ---------------------------------------------------------------------------
# Document Q&A System - environment configuration
# Copy this file to .env and fill in real values for your environment.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of origins allowed for CORS (frontend dev server, etc.)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- PostgreSQL (required) ---
# Primary (read/write) connection used by the application for all writes and
# for structured-data ingestion (creating per-sheet tables, inserting rows).
#
# No Postgres installed? Run `docker compose up -d postgres qdrant`, or on
# Windows without Docker: scripts/setup_postgres_windows.ps1 (no admin
# rights needed - see README). Either way it provisions exactly this role/db.
DATABASE_URL=postgresql+asyncpg://docqa:docqa@localhost:5432/docqa
# Read-only role used ONLY to execute LLM-generated SQL against structured
# data. Point this at a Postgres role granted SELECT only (see README /
# scripts/init_readonly_role.sql). Falls back to DATABASE_URL if unset.
DATABASE_URL_READONLY=postgresql+asyncpg://docqa_ro:docqa_ro@localhost:5432/docqa
# Max seconds a generated SQL query may run before being cancelled.
SQL_QUERY_TIMEOUT_SECONDS=5
# Max rows returned to the LLM/answer step from a generated SQL query.
SQL_MAX_ROWS=500

# --- Qdrant ---
# Must be a real server URL - no embedded/:memory: mode. No Docker
# needed: Qdrant ships a portable Windows/Linux/macOS binary, see
# https://github.com/qdrant/qdrant/releases. Web dashboard once running:
# http://localhost:6333/dashboard. Must be running before starting the
# app and before running `pytest` (tests use a separate QDRANT_COLLECTION,
# see tests/conftest.py).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

# --- Object / file storage ---
# "local" stores original uploaded files on disk under STORAGE_LOCAL_PATH.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/files

# --- LLM provider (chat / generation) ---
# One of: ollama, mock
# "ollama" is the only real (non-canned) provider this project implements -
# fully local, no API key. "mock" needs zero setup at all (deterministic
# canned-style routing/SQL) - good for a quick look, not for real answers.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=2048

# --- Embedding provider ---
# One of: ollama, local
# "local" is a lightweight, dependency-free deterministic embedder - zero
# setup, but lower semantic quality. Swap to "ollama" for real embeddings.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=384

# --- Semantic retrieval / reranking ---
# Qdrant returns SEMANTIC_CANDIDATE_K nearest neighbors by raw embedding
# similarity; a reranking pass then narrows that pool down to the
# SEMANTIC_TOP_K chunks that are actually relevant (embedding similarity
# alone surfaces plausible-but-unrelated chunks alongside the real match).
#
# RERANK_PROVIDER:
#   "cross_encoder" - fast (milliseconds-to-seconds), purpose-trained for
#     this exact task. Requires `pip install sentence-transformers` (not
#     installed by default - see requirements.txt) and downloads
#     RERANK_MODEL on first use. Model choice matters a lot here: an
#     older/smaller cross-encoder (e.g. ms-marco-MiniLM-L-6-v2, bge-
#     reranker-base) scores mostly by learned keyword-overlap, not real
#     reasoning - verified live, a bare document title outranked the
#     paragraph that actually answered the question on both of those.
#     RERANK_MODEL's default (mxbai-rerank-base-v1) correctly ranked the
#     real content above the title on the same test, at no real speed cost
#     over the older models (still a classification pass, not generation).
#   "llm"  - reuses the LLM_PROVIDER type above (ollama/mock), but with its
#     own RERANK_LLM_MODEL rather than LLM_MODEL. Judges relevance by
#     reasoning instead of pattern-matching, so it doesn't share the
#     cross_encoder failure mode above. A full generative call per rerank
#     is still slower than a cross-encoder pass.
#
#     RERANK_LLM_MODEL defaults to the same value as LLM_MODEL. A smaller,
#     dedicated model is tempting (reranking is closer to classification -
#     given N passages, which are relevant - than open-ended generation,
#     so a small model can judge it correctly) but was measured to be a
#     net loss with local Ollama: a different model than LLM_MODEL forces
#     Ollama to swap the loaded model on every question (routing/answer
#     model out, rerank model in, then back), and that reload cost more
#     time than the smaller model saved (measured: 95s, worse than one
#     model throughout). Only worth diverging from LLM_MODEL if you have a
#     hosted rerank endpoint or enough RAM/VRAM for Ollama to keep both
#     models loaded at once - verify latency actually improves before
#     relying on it.
RERANK_PROVIDER=cross_encoder
RERANK_MODEL=mixedbread-ai/mxbai-rerank-base-v1
# cross_encoder only: skips the network check the Hub library otherwise
# makes on every startup, even when RERANK_MODEL is already fully cached
# locally and nothing needs downloading (measured live: ~5.3s with the
# check vs ~1.3s without - and it also removes an internet dependency
# from startup entirely). Leave false until you've actually run the app
# once and confirmed RERANK_MODEL downloaded successfully - turning this
# on before that would make the first download fail instead of proceeding.
RERANK_OFFLINE=false
RERANK_LLM_MODEL=qwen2.5:7b
# Absolute score floor, cross_encoder only (ignored by "llm"). Leave unset
# (default - no filtering, always fill top-N by rank) unless you've
# checked real score distributions against your own documents and
# questions - cross-encoder scores aren't reliably comparable across
# passages of different length/style, so a fixed floor can drop a correct
# answer. A blank value is invalid and fails startup - comment the line
# out entirely to disable, don't leave it empty.
# RERANK_MIN_SCORE=0.0
# Relative cutoff, cross_encoder only: keep only candidates within this
# many points of the top score in the current batch, instead of a fixed
# floor - adapts to whatever scale a given question/corpus produces. Not
# a silver bullet: if nothing in a batch is relevant, scores can still
# cluster together, so this alone won't reliably detect "nothing here is
# relevant". Can combine with RERANK_MIN_SCORE. Leave unset to disable.
# RERANK_SCORE_MARGIN=5.0
SEMANTIC_CANDIDATE_K=15
SEMANTIC_TOP_K=5

# --- Ollama (local models, no API key - LLM_PROVIDER=ollama and/or
# EMBEDDING_PROVIDER=ollama). Pull models first: `ollama pull qwen2.5:7b`,
# `ollama pull nomic-embed-text`. EMBEDDING_DIM must match the embedding
# model's real output size (768 for nomic-embed-text, 1024 for
# mxbai-embed-large, ...) - a mismatch raises a clear error at upload time.
OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
# How long Ollama keeps a model loaded after the last request (a duration
# string like "30m", or "-1" for indefinite). Ollama's own default is 5
# minutes - too short for a live demo with natural pauses between
# questions: the next request after a longer gap pays a full model reload
# on top of normal inference time.
OLLAMA_KEEP_ALIVE=30m

# --- Chunking ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50
